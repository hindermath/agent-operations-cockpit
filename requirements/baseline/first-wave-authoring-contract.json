    "Collision": "Blocked"
  },
  "eligibilityContract": "requirements/baseline/series-eligibility-contract.json",
  "eligibilityCriteria": [
    "authority",
    "sideEffects",
    "reversibility",
    "writeScope",
    "decisions",
    "integration",
    "review",
    "abort",
    "recovery"
  ],
  "evidence": {
    "ownershipContract": "requirements/baseline/portfolio-ownership.json",
    "ownershipView": "requirements/baseline/portfolio-ownership.md",
    "coverageMatrix": "requirements/baseline/coverage-matrix.md",
    "seriesManifest": "specs/intake-series/aoc-phase-2/manifest.json",
    "receiptDirectory": "specs/intake-authoring-receipts"
  }
}
