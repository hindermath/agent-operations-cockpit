{
  "schemaVersion": "1.0",
  "documentType": "FirstWaveAuthoringContract",
  "requiredSeries": [
    "RAW-01",
    "RAW-02",
    "RAW-03",
    "RAW-04",
    "RAW-05",
    "RAW-06",
    "RAW-07",
    "RAW-08",
    "RAW-09"
  ],
  "concernOwnership": {
    "requiredConcernOwnersPerConcern": 1,
    "allowsMetaGovernanceOwners": true,
    "forbidsDuplicateConcernOwners": true
  },
  "reentryPolicy": {
    "AllAbsentWithCurrentAuthority": "CreateAtomic",
    "AllAbsentWithoutCurrentAuthority": "Blocked",
    "AllMatching": "VerifyOnly",
