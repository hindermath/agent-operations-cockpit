  "decisions": [
    {
      "id": "IAD501",
      "status": "Answered",
      "question": "Which transport boundary applies to later remote nodes, read-only research, trust zones, and delivery authority?",
      "answer": "RAW-05 defines a transport-neutral local Node Endpoint and read-only adapters for Host, WSL, Container, and ABS-DD. Remote nodes remain disabled until a separately reviewed RAW-06/IAD604 transport contract exists. RAW-05 grants no remote-write, process, or credential authority.",
      "evidence": "Thorsten explicitly selected option A for IRQ501 in the current repair conversation on 2026-08-06."
    },
    {
      "id": "IAD502",
      "status": "Answered",
      "question": "Which node attestation and fail-closed trust decision apply?",
      "answer": "Node type, platform, trust zone, runtime identity, declared and observed mounts, capability probe, policy version, and observation time are evaluated together. Results are Verified, Limited, Untrusted, or Unknown. Missing evidence yields Unknown, contradictory evidence yields Untrusted, and both remain read-only at most.",
      "evidence": "Thorsten explicitly selected option A for IRQ502 in the current repair conversation on 2026-08-06."
    },
    {
      "id": "IAD503",
      "status": "Answered",
      "question": "Which timeout, freshness, health, and recovery thresholds apply?",
      "answer": "Versioned profiles per node type and capability define positive probeTimeoutSeconds and freshnessTSeconds. Freshness follows the RAW-03 0.5T/T/2T model. Timeout yields Unavailable and PROBE_TIMEOUT, stale evidence yields Stale, conflicts yield Degraded, and missing evidence yields Unknown. Recovery is only a new read-only probe without mount, process, credential, network, checkout, or remote-write side effects.",
      "evidence": "Thorsten explicitly selected option A for IRQ503 in the current repair conversation on 2026-08-06."
    }
  ],
