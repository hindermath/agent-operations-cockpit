    {
      "id": "IAD301",
      "status": "Answered",
      "question": "Which clocks define observed-at, freshness-as-of, and deterministic elapsed-time evaluation?",
      "answer": "Observed-at uses the observing execution node clock as UTC RFC3339; freshness-as-of uses the evaluating AOC process clock as UTC RFC3339; in-process elapsed time uses a monotonic clock; future time fails closed outside the profile skew allowance.",
      "evidence": "Thorsten confirmed option A and supplied the refined dual-clock details in the current task on 2026-08-02."
    },
    {
      "id": "IAD302",
      "status": "Answered",
      "question": "Which freshness classes and thresholds apply, and where are they configured?",
      "answer": "Versioned source-and-capability profiles define positive T and clock-skew allowance. Fresh is age through 0.5T, Aging above 0.5T through T, Stale above T through 2T, Expired above 2T, and Unknown when age cannot be calculated. Unreviewed runtime overrides are forbidden.",
      "evidence": "Thorsten confirmed option A and supplied Fresh, Aging, Stale, Expired, Unknown with the relative 0.5T/T/2T model in the current task on 2026-08-02."
    },
    {
      "id": "IAD303",
      "status": "Answered",
      "question": "How is confidence represented and derived?",
      "answer": "Confidence is the deterministic class High, Medium, Low, or Unknown with a machine-readable reason, derived from freshness, source, authority, and conflict evidence. Numeric and percentage confidence are forbidden. This refined answer supersedes the earlier conversational no-confidence-field option.",
      "evidence": "Thorsten supplied the refined confidence-class decision in the current task on 2026-08-02."
    }
