  "decisions": [
    {
      "id": "IAD701",
      "status": "Answered",
      "question": "Which MIDI-library boundary applies?",
      "answer": "A cross-platform MIDI library is isolated behind a thin vendor-neutral adapter. Raw MIDI, SysEx, and control-change numbers remain outside the domain contract; concrete package selection is an implementation detail within these constraints.",
      "evidence": "Thorsten explicitly confirmed recommended option A for IAD701 on 2026-08-07."
    },
    {
      "id": "IAD702",
      "status": "Answered",
      "question": "Which Elgato transport and SDK boundary applies?",
      "answer": "The official Elgato SDK bridge is isolated as a thin adapter. TypeScript is allowed only where required by the SDK, and only normalized capability events and feedback leave the bridge.",
      "evidence": "Thorsten explicitly confirmed recommended option A for IAD702 on 2026-08-07."
    },
    {
      "id": "IAD703",
      "status": "Answered",
      "question": "Which first approved device set applies?",
      "answer": "The first reference wave contains exactly one representative MIDI device and one Stream Deck. Xbox remains a separate later adapter candidate requiring its own evidence.",
      "evidence": "Thorsten explicitly confirmed recommended option A for IAD703 on 2026-08-07."
    },
    {
      "id": "IAD704",
      "status": "Answered",
      "question": "Which physical lab and safety approval gate applies?",
      "answer": "Every field test requires a versioned lab inventory, device-specific risk and safety assessment, verified kill switch, supervised test plan, and documented approval. Approval alone grants no product-command or hardware-I/O authority.",
      "evidence": "Thorsten explicitly confirmed recommended option A for IAD704 on 2026-08-07."
    }
  ],
